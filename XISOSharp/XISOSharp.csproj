<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- LangVersion/ImplicitUsings/Nullable/Deterministic/ContinuousIntegrationBuild
             inherited from Directory.Build.props (per-TFM language default keeps the
             net8 API guard). -->
    <AssemblyName>XISOSharp</AssemblyName>
    <RootNamespace>XISOSharp</RootNamespace>

    <!-- Strong name signing. The key (XISOSharp.snk) is committed to the repo,
             so OSS contributors get full (non-delay, non-public) signing with no
             setup — no PublicSign/DelaySign dance needed. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>XISOSharp.snk</AssemblyOriginatorKeyFile>

    <!-- NuGet metadata -->
    <PackageId>XISOSharp</PackageId>
    <!-- Version is derived from git tags via MinVer. Tag format: v2.7.1 or 2.7.1 -->
    <Title>XISOSharp</Title>
    <Description>A library for creating, extracting, listing, and rewriting Xbox ISO (XISO) disc images. C# port of extract-xiso v2.7.1. Supports RAW, GLOBAL, XGD1, XGD2, XGD3, and Hybrid disc layouts. Provides both synchronous and asynchronous APIs with cancellation support. Strong-named and trimmable, with an AOT-compatible library surface.</Description>
    <PackageTags>xiso;xbox;iso;extract-xiso;xgd3;xgd1;xbe;disc-image;original-xbox</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/purelogiccode/XISOSharp/releases</PackageReleaseNotes>
    <MinClientVersion>5.0</MinClientVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Trimming and AOT compatibility. Scope note: this marks the *library
             surface* diplomatic to trimming/AOT for NuGet consumers. No in-repo
             project publishes AOT (BattleTests sets PublishAot false — its
             oracle harness is reflection-heavy — and there is no AOT smoke
             project), so the claim covers lib consumers only. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Surface trim/single-file incompatibilities at build time, not just
             publish (the library ships trimmable on NuGet). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Source Link + reproducible builds (Deterministic /
             ContinuousIntegrationBuild inherited from Directory.Build.props). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedAllSources>true</EmbedAllSources>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Package output. GeneratePackageOnBuild stays false so inner-loop
             `dotnet build`/`test` never mints .nupkg files; packaging is an
             explicit `dotnet pack` step (CI `pack` job, releases). -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- API compatibility validation across target frameworks -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForPackageValidation>true</EnableStrictModeForPackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="icon\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- ZArchiveSharp lives in the sibling CSharp_ZArchiveSharp repo (separate solution).
             Local dev: side-by-side checkout (..\CSharp_ZArchiveSharp) wins.
             Clean clone / CI without the sibling: fall back to the ZArchiveSharp NuGet
             package (https://www.nuget.org/packages/ZArchiveSharp). -->
    <ProjectReference Include="..\..\CSharp_ZArchiveSharp\ZArchiveSharp\ZArchiveSharp.csproj"
                      Condition="Exists('..\..\CSharp_ZArchiveSharp\ZArchiveSharp\ZArchiveSharp.csproj')" />
    <PackageReference Include="ZArchiveSharp"
                      Condition="!Exists('..\..\CSharp_ZArchiveSharp\ZArchiveSharp\ZArchiveSharp.csproj')" />
  </ItemGroup>

  <Target Name="CheckZArchiveSharpSource" BeforeTargets="CollectPackageReferences"
          Condition="!Exists('..\..\CSharp_ZArchiveSharp\ZArchiveSharp\ZArchiveSharp.csproj')">
    <Warning
      Text="Sibling CSharp_ZArchiveSharp checkout not found; falling back to the ZArchiveSharp NuGet package (version from Directory.Packages.props). For local dev, clone the sibling repo side-by-side with this one." />
  </Target>

  <!-- Source Link + versioning (package versions centralized in
         Directory.Packages.props). -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="MinVer" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
