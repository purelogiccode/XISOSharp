<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- LangVersion/ImplicitUsings/Nullable/Deterministic/ContinuousIntegrationBuild
             inherited from Directory.Build.props (per-TFM language default keeps the
             net8 API guard). -->
    <AssemblyName>XISOSharp</AssemblyName>
    <RootNamespace>XISOSharp</RootNamespace>

    <!-- Strong name signing. The key (XISOSharp.snk) is committed to the repo,
             so OSS contributors get full (non-delay, non-public) signing with no
             setup — no PublicSign/DelaySign dance needed. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>XISOSharp.snk</AssemblyOriginatorKeyFile>

    <!-- NuGet metadata -->
    <PackageId>XISOSharp</PackageId>
    <Authors>purelogiccode</Authors>
    <!-- Version is derived from git tags via MinVer. Tag format: v1.0.2 or 1.0.2 -->
    <Title>XISOSharp</Title>
    <Description>A library for creating, extracting, listing, and rewriting Xbox ISO (XISO) disc images. C# port of extract-xiso (reference build 202609111233), extended with XboxKit archival (Redump video/filler/seed/wipe/trim/petrify/rebuild, ZAR) and xdvdfs packing (build-image, CISO). Supports RAW, GLOBAL, XGD1, XGD2, XGD3, and Hybrid disc layouts. Provides both synchronous and asynchronous APIs with cancellation support. Strong-named and trimmable, with an AOT-compatible library surface.</Description>
    <PackageTags>xiso;xbox;iso;extract-xiso;xdvdfs;xgd1;xgd2;xgd3;redump;ciso;xbe;xex;disc-image;original-xbox;xbox-360</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/purelogiccode/XISOSharp/releases</PackageReleaseNotes>
    <MinClientVersion>5.0</MinClientVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Trimming and AOT compatibility. Scope note: this marks the *library
             surface* diplomatic to trimming/AOT for NuGet consumers. No in-repo
             project publishes AOT (BattleTests sets PublishAot false — its
             oracle harness is reflection-heavy — and there is no AOT smoke
             project), so the claim covers lib consumers only. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Surface trim/single-file incompatibilities at build time, not just
             publish (the library ships trimmable on NuGet). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Source Link + reproducible builds (Deterministic /
             ContinuousIntegrationBuild inherited from Directory.Build.props). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedAllSources>true</EmbedAllSources>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Package output. GeneratePackageOnBuild stays false so inner-loop
             `dotnet build`/`test` never mints .nupkg files; packaging is an
             explicit `dotnet pack` step (CI `pack` job, releases). -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- API compatibility validation across target frameworks -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForPackageValidation>true</EnableStrictModeForPackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="icon\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- ZArchiveSharp is consumed as a NuGet package (https://www.nuget.org/packages/ZArchiveSharp).
              The library lives in the sibling CSharp_ZArchiveSharp repo (separate solution);
              local changes there are consumed here by publishing a new package version. -->
    <PackageReference Include="ZArchiveSharp" Version="1.0.2" />
  </ItemGroup>

  <!-- Source Link + versioning. -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.236">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
