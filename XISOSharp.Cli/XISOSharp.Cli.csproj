<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Tool ships as a published single-file binary, never as NuGet, so no
             EnablePackageValidation here — package compat gates apply to the
             library (the only packable project) only. -->
    <IsPackable>false</IsPackable>
    <!-- Multi-target to match the library so XISOSharp.Tests (net8/9/10) can
             reference the CLI on every TFM and exercise all lib closures. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- AssemblyName stays XISOSharp.Cli (project identity + RootNamespace): the
             class library already owns the XISOSharp simple name, and the CLI
             references it — building the CLI as XISOSharp.dll would collide
             with the referenced XISOSharp.dll in the same output folder.
             The *published* single-file binary is still named XISOSharp(.exe)
             via the RenamePublishedExeToXisoSharp target below. -->
    <AssemblyName>XISOSharp.Cli</AssemblyName>
    <RootNamespace>XISOSharp.Cli</RootNamespace>
    <ApplicationIcon>icon\icon.ico</ApplicationIcon>
    <!-- Single RID source of truth (matches publish-cli.ps1 defaults and
             docs/building.md): win-x64, win-arm64, linux-x64, linux-arm64,
             osx-x64, osx-arm64. XboxKit parity, no 32-bit RID. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Distribution defaults: every self-contained `dotnet publish -r` for a
             listed RID yields a trimmed single-file binary with no runtime to install. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!-- Surface trim/single-file incompatibilities at build time, not just publish. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XISOSharp\XISOSharp.csproj" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- Version stamps (Version/InformationalVersion/FileVersion) derived from git tags, same as the library. -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XISOSharp.Tests" />
  </ItemGroup>

  <!-- Published binary ships as XISOSharp(.exe), not XISOSharp.Cli(.exe).
       Covers both `dotnet publish` directly and publish-cli.ps1. Only the
       file name changes — the build output (XISOSharp.Cli.dll) is untouched,
       so the library reference never collides. -->
  <Target Name="RenamePublishedExeToXisoSharp" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)XISOSharp.Cli.exe"
          DestinationFiles="$(PublishDir)XISOSharp.exe"
          Condition="Exists('$(PublishDir)XISOSharp.Cli.exe')" />
    <Move SourceFiles="$(PublishDir)XISOSharp.Cli"
          DestinationFiles="$(PublishDir)XISOSharp"
          Condition="Exists('$(PublishDir)XISOSharp.Cli')" />
    <Move SourceFiles="$(PublishDir)XISOSharp.Cli.pdb"
          DestinationFiles="$(PublishDir)XISOSharp.pdb"
          Condition="Exists('$(PublishDir)XISOSharp.Cli.pdb')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
