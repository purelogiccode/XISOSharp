<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XISOSharp.Gui.ViewModels"
        x:Class="XISOSharp.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="XISOSharp"
        Icon="avares://XISOSharp.Gui/icon/icon.ico"
        Width="1060" Height="820" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Header -->
    <Style Selector="TextBlock.apptitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.appsubtitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="Border.logomark">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.logomarktext">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Header actions (Donate / About / Exit) -->
    <Style Selector="Button.headeraction">
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Button.headeraction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.headeraction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.headeraction:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>

    <!-- Cards -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BoxShadow" Value="0 10 24 0 #59000000" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="TextBox.log">
      <Setter Property="Background" Value="{DynamicResource AppLogBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Margin="2,0,2,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="logomark" ToolTip.Tip="XISOSharp">
            <TextBlock Classes="logomarktext" Text="X" ToolTip.Tip="XISOSharp" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="apptitle" Text="XISOSharp" ToolTip.Tip="XISOSharp — Xbox disc image toolkit" />
            <TextBlock Classes="appsubtitle"
                       Text="Extract, create, rewrite and archive Xbox disc images"
                       ToolTip.Tip="Extract, create, rewrite and archive Xbox disc images" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Margin="16,0"
                   MaxWidth="360" TextAlignment="Right"
                   Text="Drop .iso / .xiso / .cso / .zar files or folders anywhere — the matching tab fills in."
                   ToolTip.Tip="Drag and drop files or folders onto the window to queue the matching operation" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="accent" Content="Donate" Click="Donate_Click"
                  ToolTip.Tip="Support the development of XISOSharp — opens the PureLogicCode donation page" />
          <Button Classes="headeraction" Content="About" Click="About_ClickAsync"
                  ToolTip.Tip="View application information, version, and credits" />
          <Button Classes="headeraction" Content="Exit" Click="Exit_Click"
                  ToolTip.Tip="Close the application" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar" Margin="0,14,0,0"
            ToolTip.Tip="Run status: progress, cancel, last exit code and CLI status">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <ProgressBar IsVisible="{Binding IsRunning}" IsIndeterminate="True" Width="160" VerticalAlignment="Center"
                     ToolTip.Tip="Progress of the running operation" />
        <Button Classes="accent" Content="Cancel" Command="{Binding CancelRunCommand}" IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="Cancel the running operation" />
        <TextBlock Text="{Binding LastExit}" VerticalAlignment="Center" FontWeight="SemiBold"
                   ToolTip.Tip="Exit code of the last run" />
        <TextBlock Text="{Binding CliStatus}" VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"
                   ToolTip.Tip="CLI resolution status" />
      </StackPanel>
    </Border>

    <!-- Log console -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,14,0,0"
            ToolTip.Tip="Live CLI output console">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <TextBlock Text="CLI output" Classes="section" Margin="0" VerticalAlignment="Center"
                     ToolTip.Tip="Live output from the CLI process" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Clear" Command="{Binding ClearLogCommand}" ToolTip.Tip="Clear the log console" />
            <CheckBox Content="Overwrite existing outputs (-y, else -n)" IsChecked="{Binding OverwriteExisting}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Answer overwrite prompts with -y; unchecked answers -n" />
          </StackPanel>
        </Grid>
        <TextBox Name="LogBox" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                 Classes="log" Height="170"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"
                 ToolTip.Tip="Live CLI output; select text to copy" />
      </DockPanel>
    </Border>

    <!-- Operation tabs -->
    <TabControl Name="OpTabs" TabStripPlacement="Left" ToolTip.Tip="Choose an operation">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="3" />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>

      <TabItem Header="Extract" ToolTip.Tip="Extract, list, tree, unpack, inspect and copy files out of a disc image">
        <ScrollViewer>
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Image (.iso/.cso/.zar)" VerticalAlignment="Center" ToolTip.Tip="Input image to extract from" />
              <TextBox Grid.Column="1" Text="{Binding ExImage}" PlaceholderText="game.iso"
                       ToolTip.Tip="Path to the source disc image (.iso, .cso or .zar)" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseExImage_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the source image" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Destination dir" VerticalAlignment="Center" ToolTip.Tip="Folder to write extracted files to" />
              <TextBox Grid.Column="1" Text="{Binding ExDest}" PlaceholderText="(same folder as image)"
                       ToolTip.Tip="Extraction destination folder (empty = next to the image)" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseExDest_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the destination folder" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Classes="accent" Content="Extract" Command="{Binding RunExtractCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Extract every file from the image" />
              <Button Content="List" Command="{Binding RunListCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Print the file listing (extract-xiso -l)" />
              <Button Content="Tree" Command="{Binding RunTreeCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Print the directory tree (extract-xiso -t)" />
              <Button Content="Unpack" Command="{Binding RunUnpackCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Extract with resume support: files already on disk are skipped" />
            </StackPanel>
            <TextBlock Classes="section" Text="Inspect" ToolTip.Tip="Read one in-image path without extracting" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="In-image path" VerticalAlignment="Center" ToolTip.Tip="Image-internal path to inspect" />
              <TextBox Grid.Column="1" Text="{Binding ExInfoPath}" PlaceholderText="/default.xbe (empty = volume info)"
                       ToolTip.Tip="File path inside the image; leave empty for volume info" />
              <Button Grid.Column="2" Content="Info" Command="{Binding RunInfoCommand}" IsEnabled="{Binding CanRun}" Margin="6,0,0,0"
                      ToolTip.Tip="Show info for the in-image path" />
            </Grid>
            <TextBlock Classes="section" Text="Copy out" ToolTip.Tip="Copy a single file out of the image" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="In-image path" VerticalAlignment="Center" ToolTip.Tip="Image-internal path to copy out" />
              <TextBox Grid.Column="1" Text="{Binding ExCopyPath}" PlaceholderText="/docs/readme.txt"
                       ToolTip.Tip="File path inside the image to copy out" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Destination file" VerticalAlignment="Center" ToolTip.Tip="Where to write the copied file" />
              <TextBox Grid.Column="1" Text="{Binding ExCopyDest}" PlaceholderText="readme.txt"
                       ToolTip.Tip="Output file path for the copied file" />
              <Button Grid.Column="2" Content="Copy out" Command="{Binding RunCopyOutCommand}" IsEnabled="{Binding CanRun}" Margin="6,0,0,0"
                      ToolTip.Tip="Copy the file out of the image" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Create" ToolTip.Tip="Build a new XISO image from a source directory">
        <ScrollViewer>
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Source directory" VerticalAlignment="Center" ToolTip.Tip="Directory whose contents become the image" />
              <TextBox Grid.Column="1" Text="{Binding CrSource}" ToolTip.Tip="Folder to pack into a new XISO image" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseCrSource_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the source directory" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Image name" VerticalAlignment="Center" ToolTip.Tip="Output image file name" />
              <TextBox Grid.Column="1" Text="{Binding CrName}" PlaceholderText="(defaults to directory name)"
                       ToolTip.Tip="Output file name (defaults to the directory name)" />
            </Grid>
            <TextBlock Text="Exclude globs (-X, one per line)" Margin="0,8,0,2"
                       ToolTip.Tip="Patterns of files to exclude from the image" />
            <TextBox Text="{Binding CrExcludes}" AcceptsReturn="True" Height="70" PlaceholderText="*.tmp&#x0a;screenshots/**"
                     ToolTip.Tip="One glob per line, e.g. *.tmp or screenshots/**" />
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
              <CheckBox Content="Skip $SystemUpdate (-s)" IsChecked="{Binding CrSkipSystemUpdate}"
                        ToolTip.Tip="Omit the $SystemUpdate folder (-s)" />
              <CheckBox Content="Disable .xbe media patch (-m)" IsChecked="{Binding CrDisableXbePatch}"
                        ToolTip.Tip="Do not patch .xbe media flags (-m)" />
            </StackPanel>
            <Button Classes="accent" Content="Create image" Command="{Binding RunCreateCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Create the XISO image" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Rewrite" ToolTip.Tip="Rewrite images to the Redump layout, and wipe/trim filler">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Text="Images (one per line)" Margin="0,0,0,2" ToolTip.Tip="Images to rewrite, one path per line" />
            <TextBox Text="{Binding RwImages}" AcceptsReturn="True" Height="70" PlaceholderText="game.iso"
                     ToolTip.Tip="One image path per line" />
            <Button Content="Add images…" Click="AddRwImages_ClickAsync" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTip.Tip="Add images to the rewrite list" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Custom output (-o)" VerticalAlignment="Center" ToolTip.Tip="Explicit output image (-o)" />
              <TextBox Grid.Column="1" Text="{Binding RwOutput}" PlaceholderText="(empty = rewrite in place rules)"
                       ToolTip.Tip="Output path for the rewritten image (empty = default rules)" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseRwOutput_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the output image path" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Work directory (-d)" VerticalAlignment="Center" ToolTip.Tip="Scratch directory used while rewriting (-d)" />
              <TextBox Grid.Column="1" Text="{Binding RwWorkDir}" ToolTip.Tip="Working directory for temporary files" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseRwWorkDir_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the work directory" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
              <CheckBox Content="Delete old (-D)" IsChecked="{Binding RwDeleteOld}"
                        ToolTip.Tip="Delete the original after a successful rewrite (-D)" />
              <CheckBox Content="Disable .xbe patch (-m)" IsChecked="{Binding RwDisableXbePatch}"
                        ToolTip.Tip="Do not patch .xbe media flags (-m)" />
            </StackPanel>
            <TextBlock Classes="section" Text="Post-rewrite validation" ToolTip.Tip="Optionally validate the rewritten image" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox Content="Validate (--validate)" IsChecked="{Binding RwValidate}"
                        ToolTip.Tip="Run validation after rewriting (--validate)" />
              <CheckBox Content="Checksums (slower)" IsChecked="{Binding RwChecksums}"
                        ToolTip.Tip="Also verify SHA-256 checksums (slower)" />
              <CheckBox Content="Strict (exit 2)" IsChecked="{Binding RwStrict}"
                        ToolTip.Tip="Fail with exit code 2 on validation issues" />
            </StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="JSON report" VerticalAlignment="Center" ToolTip.Tip="Write a JSON validation report" />
              <TextBox Grid.Column="1" Text="{Binding RwReport}" PlaceholderText="(optional) report.json"
                       ToolTip.Tip="Report output path (optional)" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseRwReport_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the report path" />
            </Grid>
            <Button Classes="accent" Content="Rewrite" Command="{Binding RunRewriteCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Rewrite the listed images" />
            <TextBlock Classes="section" Text="Wipe / trim (Redump archival)" ToolTip.Tip="Redump archival helpers for filler sectors and padding" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Image" VerticalAlignment="Center" ToolTip.Tip="Image to wipe or trim" />
              <TextBox Grid.Column="1" Text="{Binding WpImage}" ToolTip.Tip="Path to the image" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseWpImage_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the image" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Output" VerticalAlignment="Center" ToolTip.Tip="Optional output image" />
              <TextBox Grid.Column="1" Text="{Binding WpOutput}" PlaceholderText="(optional)"
                       ToolTip.Tip="Output path (empty = in place)" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Content="Wipe filler" Command="{Binding RunWipeCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Replace filler sectors with zeros" />
              <Button Content="Trim" Command="{Binding RunTrimCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Trim padding from the image" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Rebuild" ToolTip.Tip="Rebuild a Redump ISO from components">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Text="Components, one per line: &lt;xiso|game.zar&gt; [video.iso] [filler|seed] [su…]" Margin="0,0,0,2"
                       ToolTip.Tip="One component per line: game.xiso or game.zar, optional video ISO, filler/seed and su options" />
            <TextBox Text="{Binding RbParts}" AcceptsReturn="True" Height="90" PlaceholderText="game.xiso&#x0a;video.iso"
                     ToolTip.Tip="Components to assemble the Redump ISO from" />
            <Button Content="Add files…" Click="AddRbParts_ClickAsync" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTip.Tip="Add component files" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Output Redump ISO" VerticalAlignment="Center" ToolTip.Tip="Output Redump-style ISO path" />
              <TextBox Grid.Column="1" Text="{Binding RbOutput}" PlaceholderText="redump.iso"
                       ToolTip.Tip="Where to write the rebuilt ISO" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseRbOutput_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the output ISO path" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Security sectors" VerticalAlignment="Center" ToolTip.Tip="Optional security-sector source" />
              <TextBox Grid.Column="1" Text="{Binding RbSectors}" PlaceholderText="(optional) sectors.txt"
                       ToolTip.Tip="Path to a security sectors file (optional)" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseRbSectors_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the sectors file" />
            </Grid>
            <Button Classes="accent" Content="Rebuild" Command="{Binding RunRebuildCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Rebuild the Redump ISO" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Compress" ToolTip.Tip="Compress an ISO or directory to CISO (.cso)">
        <ScrollViewer>
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Source (dir or ISO)" VerticalAlignment="Center" ToolTip.Tip="Directory or ISO to compress" />
              <TextBox Grid.Column="1" Text="{Binding CpSource}" ToolTip.Tip="Source directory or .iso file" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <Button Content="File…" Click="BrowseCpSourceFile_ClickAsync" ToolTip.Tip="Pick a source file" />
                <Button Content="Folder…" Click="BrowseCpSourceFolder_ClickAsync" ToolTip.Tip="Pick a source folder" />
              </StackPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Output .cso" VerticalAlignment="Center" ToolTip.Tip="Output CISO path" />
              <TextBox Grid.Column="1" Text="{Binding CpOutput}" PlaceholderText="(auto-derived)"
                       ToolTip.Tip="Output .cso path (empty = auto-derived)" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseCpOutput_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the output path" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Level (0–9)" VerticalAlignment="Center" ToolTip.Tip="Compression level" />
              <NumericUpDown Grid.Column="1" Value="{Binding CpLevel}" Minimum="0" Maximum="9" HorizontalAlignment="Left" Width="120"
                             ToolTip.Tip="0 = store, 9 = smallest (default)" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="CISO version" VerticalAlignment="Center" ToolTip.Tip="CISO container version" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding CisoVersions}" SelectedItem="{Binding CpVersion}" HorizontalAlignment="Left" Width="120"
                        ToolTip.Tip="Version 2 writes LZ4 sectors; version 1 classic DEFLATE" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Split bytes" VerticalAlignment="Center" ToolTip.Tip="Split the .cso into parts" />
              <TextBox Grid.Column="1" Text="{Binding CpSplit}" PlaceholderText="(default ~4 GiB; 0 = single .cso)"
                       ToolTip.Tip="Part size in bytes (default ~4 GiB; 0 = single .cso)" />
            </Grid>
            <TextBlock Classes="hint" Text="Level 0 = store, 9 = smallest (default). Version 2 writes LZ4 sectors, version 1 classic DEFLATE."
                       ToolTip.Tip="Level 0 stores data; level 9 is smallest. Version 2 uses LZ4, version 1 classic DEFLATE" />
            <Button Classes="accent" Content="Compress" Command="{Binding RunCompressCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Compress to CISO" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="ZAR" ToolTip.Tip="Pack an image into a ZArchive (.zar) for Xenia canary">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Text="Source (ISO / XISO / Redump .iso) — one file" Margin="0,0,0,2"
                       ToolTip.Tip="Source image to pack into .zar" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Source image" VerticalAlignment="Center" ToolTip.Tip="Image to pack into .zar" />
              <TextBox Grid.Column="1" Text="{Binding ZaSource}" PlaceholderText="game.iso"
                       ToolTip.Tip="Path to the source image" />
              <Button Grid.Column="2" Content="File…" Click="BrowseZaSourceFile_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the source image" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Output .zar" VerticalAlignment="Center" ToolTip.Tip="Output ZArchive path" />
              <TextBox Grid.Column="1" Text="{Binding ZaOutput}" PlaceholderText="(auto-derived next to the source)"
                       ToolTip.Tip="Output .zar path (empty = next to the source)" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseZaOutput_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the output path" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="If output exists" VerticalAlignment="Center" ToolTip.Tip="Collision policy when the output already exists" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ZarPolicies}" SelectedItem="{Binding ZaPolicy}"
                        HorizontalAlignment="Left" Width="170"
                        ToolTip.Tip="Overwrite, skip or auto-rename the existing output" />
            </Grid>
            <TextBlock Classes="hint" Margin="0,8,0,0"
                       Text="Packs the image tree with zstd blocks (level 6, raw fallback) into a single .zar that loads directly in Xenia canary. Redump ISOs are auto-detected and packed from the game partition."
                       ToolTip.Tip="ZAR packs the image with zstd blocks for Xenia canary" />
            <Button Classes="accent" Content="Create ZAR" Command="{Binding RunZarCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Create the ZArchive" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Decompress" ToolTip.Tip="Decompress a CISO (.cso) back to ISO">
        <ScrollViewer>
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="CSO file" VerticalAlignment="Center" ToolTip.Tip="CISO file to decompress" />
              <TextBox Grid.Column="1" Text="{Binding DcCso}" PlaceholderText="game.cso"
                       ToolTip.Tip="Path to the .cso file" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseDcCso_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the .cso file" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Output ISO" VerticalAlignment="Center" ToolTip.Tip="Output ISO path" />
              <TextBox Grid.Column="1" Text="{Binding DcOutput}" PlaceholderText="(auto-derived)"
                       ToolTip.Tip="Where to write the ISO (empty = auto-derived)" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseDcOutput_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the output path" />
            </Grid>
            <Button Classes="accent" Content="Decompress" Command="{Binding RunDecompressCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Decompress the CISO to ISO" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Validate" ToolTip.Tip="Validate source/output images and compute SHA3-256 checksums">
        <ScrollViewer>
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Source ISO" VerticalAlignment="Center" ToolTip.Tip="Reference image" />
              <TextBox Grid.Column="1" Text="{Binding VaSource}" ToolTip.Tip="Path to the source ISO" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseVaSource_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the source ISO" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Output ISO" VerticalAlignment="Center" ToolTip.Tip="Image to compare against the source" />
              <TextBox Grid.Column="1" Text="{Binding VaOutput}" ToolTip.Tip="Path to the output ISO" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseVaOutput_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the output ISO" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
              <CheckBox Content="Verify SHA-256 checksums (slower)" IsChecked="{Binding VaChecksums}"
                        ToolTip.Tip="Compare SHA-256 hashes of every file (slower)" />
            </StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="JSON report" VerticalAlignment="Center" ToolTip.Tip="Write a JSON validation report" />
              <TextBox Grid.Column="1" Text="{Binding VaReport}" PlaceholderText="(optional) report.json"
                       ToolTip.Tip="Report output path (optional)" />
              <Button Grid.Column="2" Content="Save as…" Click="BrowseVaReport_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the report path" />
            </Grid>
            <Button Classes="accent" Content="Validate conversion" Command="{Binding RunValidateCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Validate that the output matches the source" />
            <TextBlock Classes="section" Text="Image checksums (SHA3-256)" ToolTip.Tip="Compute SHA3-256 checksums of images" />
            <TextBlock Text="Images (one per line; empty = validate-tab source)" Margin="0,0,0,2"
                       ToolTip.Tip="Images to hash, one path per line" />
            <TextBox Text="{Binding CsImages}" AcceptsReturn="True" Height="70"
                     ToolTip.Tip="One image path per line (empty = use the Validate tab source)" />
            <Button Content="Add images…" Click="AddCsImages_ClickAsync" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTip.Tip="Add images to hash" />
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
              <CheckBox Content="Silent (hashes only)" IsChecked="{Binding CsSilent}"
                        ToolTip.Tip="Only print hashes, no per-file detail" />
              <Button Content="Checksum" Command="{Binding RunChecksumCommand}" IsEnabled="{Binding CanRun}"
                      ToolTip.Tip="Compute SHA3-256 checksums" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Batch" ToolTip.Tip="Process every .iso in a directory">
        <ScrollViewer>
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Directory" VerticalAlignment="Center" ToolTip.Tip="Directory containing .iso files" />
              <TextBox Grid.Column="1" Text="{Binding BaDir}" ToolTip.Tip="Folder to scan for .iso files" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseBaDir_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the directory" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
              <CheckBox Content="Recursive" IsChecked="{Binding BaRecursive}"
                        ToolTip.Tip="Include subdirectories" />
            </StackPanel>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Mode" VerticalAlignment="Center" ToolTip.Tip="Operation to run on each image" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding BatchModes}" SelectedItem="{Binding BaMode}" HorizontalAlignment="Left" Width="160"
                        ToolTip.Tip="Extract, list, tree, rewrite or audit" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="Destination (-d)" VerticalAlignment="Center" ToolTip.Tip="Output folder (-d)" />
              <TextBox Grid.Column="1" Text="{Binding BaDest}" PlaceholderText="(extract/rewrite outputs)"
                       ToolTip.Tip="Destination for extract/rewrite outputs" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseBaDest_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the destination" />
            </Grid>
            <TextBlock Classes="hint" Text="Processes every .iso in the directory (extract, list, tree, rewrite, audit)."
                       ToolTip.Tip="Runs the chosen mode on every .iso found in the directory" />
            <Button Classes="accent" Content="Run batch" Command="{Binding RunBatchCommand}" IsEnabled="{Binding CanRun}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Start the batch run" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Settings" ToolTip.Tip="CLI location and default options">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="section" Text="XISOSharp CLI" ToolTip.Tip="Location of the CLI executable" />
            <Grid Classes="row" ColumnDefinitions="150,*,Auto">
              <TextBlock Text="CLI path" VerticalAlignment="Center" ToolTip.Tip="CLI executable used by the GUI" />
              <TextBox Grid.Column="1" Text="{Binding CliPath}" PlaceholderText="(auto-detect)"
                       ToolTip.Tip="Path to XISOSharp(.exe); empty = auto-detect" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseCliPath_ClickAsync" Margin="6,0,0,0"
                      ToolTip.Tip="Pick the CLI executable" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button Classes="accent" Content="Detect + probe" Command="{Binding DetectCliCommand}"
                      ToolTip.Tip="Auto-detect the CLI and verify it responds to -v" />
              <Button Content="Save settings" Command="{Binding SaveSettingsCommand}"
                      ToolTip.Tip="Persist the CLI path and defaults" />
            </StackPanel>
            <TextBlock Text="{Binding CliStatus}" Margin="0,8,0,0" TextWrapping="Wrap"
                       ToolTip.Tip="Current CLI resolution status" />
            <TextBlock Classes="hint" Margin="0,8,0,0"
                       Text="Resolution order: this setting, then XISOSharp next to the GUI executable, then PATH. Settings persist per-user under the OS application-data folder: XISOSharp/gui-settings.json (Windows %AppData%, Linux/macOS ~/.config)."
                       ToolTip.Tip="Resolution order: setting, then sibling of the GUI, then PATH" />
            <TextBlock Classes="section" Text="Defaults" ToolTip.Tip="Default options for runs" />
            <CheckBox Content="Overwrite existing outputs by default (-y, else -n)" IsChecked="{Binding OverwriteExisting}"
                      ToolTip.Tip="Answer overwrite prompts with -y; unchecked answers -n" />
            <TextBlock Classes="hint" Margin="0,4,0,0"
                       Text="The CLI can ask to overwrite files; the GUI always answers it up front, so a run never blocks on a hidden prompt."
                       ToolTip.Tip="The GUI answers overwrite prompts up front so runs never block" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
