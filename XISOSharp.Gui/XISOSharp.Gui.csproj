<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe is intentional on this cross-platform target: it suppresses the
             console window on Windows; on Linux/macOS OutputType is ignored and the
             app runs from the desktop file/terminal as usual. -->
    <OutputType>WinExe</OutputType>
    <!-- Tool ships as a published single-file binary, never as NuGet, so no
             EnablePackageValidation here — package compat gates apply to the
             library (the only packable project) only. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ImplicitUsings/Nullable inherited from Directory.Build.props. -->
    <AssemblyName>XISOSharp.Gui</AssemblyName>
    <RootNamespace>XISOSharp.Gui</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 exe icon, same file the CLI embeds (ignored on non-Windows RIDs). -->
    <ApplicationIcon>icon\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Single RID source of truth (matches publish-gui.ps1 defaults and
             docs/building.md): win-x64, win-arm64, linux-x64, linux-arm64,
             osx-x64, osx-arm64. XboxKit parity, no 32-bit RID. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Distribution defaults: every self-contained `dotnet publish -r` for a
         listed RID yields a single-file binary with no runtime to install.
         NOTE: PublishTrimmed stays false — Avalonia relies on XAML/reflection
         and does not survive trimming. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Bundle content + package native libraries (Skia/HarfBuzz) into the
         single file for self-extraction, so the publish output stays one
         binary per app instead of a folder of loose DLLs. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Surface single-file incompatibilities at build time, not just publish.
             (No EnableTrimAnalyzer: the app intentionally ships untrimmed, so trim
             analysis would flag the entire Avalonia closure by design.) -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Window/runtime icon (MainWindow Icon=avares://...); same art as the exe icon. -->
    <AvaloniaResource Include="icon\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\XISOSharp\XISOSharp.csproj" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- DevTools only: no 12.x build of Avalonia.Diagnostics is published yet
             (latest is 11.x), so keep it Debug-only and out of the Release closure
             entirely. Upgrade to 12.x when available. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Version stamps (Version/InformationalVersion/FileVersion) derived from git tags, same as the library and CLI. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.248">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- BUG-X-001: single source of truth for logging lives in XISOSharp.Cli/Logging
         (trim-safe source-gen payload kept intact). These linked items compile the same
         sources into the GUI under the GUI namespace (LOGGING_NS_GUI); do not copy them. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);LOGGING_NS_GUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\XISOSharp.Cli\Logging\AppLogging.cs" Link="Logging\AppLogging.cs" />
    <Compile Include="..\XISOSharp.Cli\Logging\BugReporter.cs" Link="Logging\BugReporter.cs" />
    <Compile Include="..\XISOSharp.Cli\Logging\BugReportSink.cs" Link="Logging\BugReportSink.cs" />
    <Compile Include="..\XISOSharp.Cli\Logging\EnvironmentInfo.cs" Link="Logging\EnvironmentInfo.cs" />
  </ItemGroup>

  <!-- Dev-loop convenience (best effort, never fails the build): stage the
       CLI's shipped XISOSharp binary (plus its dll/runtimeconfig) beside the
       GUI so the sibling lookup (CliLocator → XISOSharp(.exe), legacy
       XISOSharp.Cli fallback) resolves from plain `dotnet build` output,
       mirroring the bundle layouts. Every entry is Exists-guarded, so a
       missing CLI build is a silent no-op, not a build break.
       BuildCliForStaging compiles the CLI out-of-band via the MSBuild task
       (deliberately NOT a ProjectReference: referencing an executable would
       cascade publish context and trip NETSDK1151 on framework-dependent
       `dotnet publish -r`). Publish globals are stripped via
       RemoveProperties so the CLI always gets a plain net10.0 Build. -->
  <Target Name="BuildCliForStaging" BeforeTargets="StageCliBesideGui" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\XISOSharp.Cli\XISOSharp.Cli.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun" />
  </Target>
  <Target Name="StageCliBesideGui" AfterTargets="Build">
    <ItemGroup>
      <CliStageFiles Include="..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.exe" Condition="Exists('..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.exe')" />
      <CliStageFiles Include="..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp" Condition="Exists('..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp')" />
      <CliStageFiles Include="..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.Cli" Condition="Exists('..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.Cli')" />
      <CliStageFiles Include="..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.Cli.dll" Condition="Exists('..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.Cli.dll')" />
      <CliStageFiles Include="..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.Cli.runtimeconfig.json" Condition="Exists('..\XISOSharp.Cli\bin\$(Configuration)\net10.0\XISOSharp.Cli.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(CliStageFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(OutDir)XISOSharp&quot;" Condition="Exists('$(OutDir)XISOSharp') and !$([MSBuild]::IsOSPlatform('Windows'))" ContinueOnError="true" />
  </Target>

</Project>
