<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Dev tool, never packed. -->
    <IsPackable>false</IsPackable>
    <!-- Match the library/test target so XISOSharp.Tests can reference the
             Generator project (single owner of the TestDataWriter fixture
             logic). -->
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>XISOSharp.TestDataGenerator</AssemblyName>
    <RootNamespace>XISOSharp.TestDataGenerator</RootNamespace>
    <AssemblyTitle>XISOSharp TestData Generator</AssemblyTitle>
    <Description>Restores the TestData fixture (deterministic source tree + prebuilt XISO) used by the test suite.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)XISOSharp\XISOSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.339">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Version stamp derived from git tags, same as the other projects. -->
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
