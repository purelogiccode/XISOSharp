<Project>

  <PropertyGroup>
    <!-- Repository root, absolute, with a trailing separator. Cross-project paths
         (linked Compile items, staged CLI outputs, the strong-name key) go through
         $(RepoRoot) so moving a project folder only touches the .sln and the
         reference in here, not every consumer's relative "..\" chain. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pin the language version for every project; .NET 11 ships C# 15. -->
    <LangVersion>15.0</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/purelogiccode/XISOSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/purelogiccode/XISOSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>master</RepositoryBranch>
  </PropertyGroup>

</Project>
