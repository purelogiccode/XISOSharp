<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The CLI doubles as a dotnet tool (`dotnet tool install -g XISOSharp.Tool`,
         command `xisosharp`) and as the release-bundle executable. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xisosharp</ToolCommandName>
    <PackageId>XISOSharp.Tool</PackageId>
    <Description>XISOSharp command-line tool: create, extract, list, rewrite, compress and archive Xbox XISO/XDVDFS images. Reads ISO, split ISO, CISO, CCI and ZAR; writes XISO, CISO, CCI and ZAR; includes Redump/XboxKit archival modes.</Description>
    <PackageTags>xiso;xbox;iso;extract-xiso;xdvdfs;ciso;cci;zar;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>XISOSharp.Cli</AssemblyName>
    <RootNamespace>XISOSharp.Cli</RootNamespace>
    <ApplicationIcon>icon\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers Condition="'$(_IsPacking)' != 'true'">win-x86;win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishSingleFile Condition="'$(_IsPacking)' != 'true'">true</PublishSingleFile>
    <PublishTrimmed Condition="'$(_IsPacking)' != 'true'">true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\XISOSharp\XISOSharp.csproj" />
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Version stamps (Version/InformationalVersion/FileVersion) derived from git tags, same as the library. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XISOSharp.Tests" />
  </ItemGroup>

  <!-- Published binary ships as XISOSharp(.exe), not XISOSharp.Cli(.exe).
       Covers both `dotnet publish` directly and publish-cli.ps1. Only the
       file name changes — the build output (XISOSharp.Cli.dll) is untouched,
       so the library reference never collides. -->
  <Target Name="RenamePublishedExeToXisoSharp" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)XISOSharp.Cli.exe"
          DestinationFiles="$(PublishDir)XISOSharp.exe"
          Condition="Exists('$(PublishDir)XISOSharp.Cli.exe')" />
    <Move SourceFiles="$(PublishDir)XISOSharp.Cli"
          DestinationFiles="$(PublishDir)XISOSharp"
          Condition="Exists('$(PublishDir)XISOSharp.Cli')" />
    <Move SourceFiles="$(PublishDir)XISOSharp.Cli.pdb"
          DestinationFiles="$(PublishDir)XISOSharp.pdb"
          Condition="Exists('$(PublishDir)XISOSharp.Cli.pdb')" />
  </Target>

  <!-- Every build also yields XISOSharp beside the real output: a copy of
       the XISOSharp.Cli apphost. The apphost embeds the path to
       XISOSharp.Cli.dll, so the alias runs the same app with no library-name
       collision — same spirit as the publish rename above, but for plain
       `dotnet build` output. (Flowing this alias to referencing projects via
       CopyToOutputDirectory items is unreliable: GetCopyToOutputDirectoryItems
       results are cached per instance before AfterBuild runs, so consumers
       alias their own copy — see XISOSharp.BattleTests.csproj.)
       The extensionless Unix apphost gets the same alias so the GUI sibling
       lookup (CliLocator → XISOSharp, XISOSharp.Cli fallback) resolves from
       build output on every OS, mirroring the bundle layouts. -->
  <Target Name="AliasBuiltExeAsXisoSharp" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)XISOSharp.Cli.exe"
          DestinationFiles="$(OutDir)XISOSharp.exe"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)XISOSharp.Cli.exe')" />
    <Copy SourceFiles="$(OutDir)XISOSharp.Cli"
          DestinationFiles="$(OutDir)XISOSharp"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)XISOSharp.Cli')" />
    <Exec Command="chmod +x &quot;$(OutDir)XISOSharp&quot;"
          Condition="Exists('$(OutDir)XISOSharp') and !$([MSBuild]::IsOSPlatform('Windows'))"
          ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.320">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
