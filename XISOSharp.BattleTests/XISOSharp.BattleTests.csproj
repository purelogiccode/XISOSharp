<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Dev/test harness, never packed. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ImplicitUsings/Nullable inherited from Directory.Build.props. -->
    <RootNamespace>XISOSharp.BattleTests</RootNamespace>
    <AssemblyName>XISOSharp.BattleTests</AssemblyName>
    <!-- No AOT here by design: the harness shells out to native exes and captures
         process output; AOT-compat remains a library-surface claim (see
         XISOSharp.csproj), not a harness one. -->
    <PublishAot>false</PublishAot>
    <!-- The harness writes battle reports next to the sources. Keep that churn
         out of the SDK globs and IDE scans so builds and file watching stay fast. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);BattleReports\**;*.log;*.pid</DefaultItemExcludes>
  </PropertyGroup>

  <!-- CLI-vs-CLI battle: the harness shells out to XISOSharp.Cli.exe (built and
       copied beside the harness by this reference) and extract-xiso.exe. The
       XISOSharp library is pulled in transitively; no in-process API use. -->
  <ItemGroup>
    <ProjectReference Include="..\XISOSharp.Cli\XISOSharp.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="extract-xiso.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Version stamp derived from git tags, same as the other projects. -->
    <PackageReference Include="MinVer" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
